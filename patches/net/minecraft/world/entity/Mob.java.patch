+    private boolean canSkipUpdate() {
+        if (this.isBaby()) {
+            return false;
+        }
+
+        if (this.hurtTime > 0) {
+            return false;
+        }
+
+        if (this.tickCount < 20) {
+            return false;
+        }
+
+        List listPlayers = this.getListPlayers(this.level());
+        if (listPlayers == null) {
+            return false;
+        }
+
+        if (listPlayers.size() != 1) {
+            return false;
+        }
+
+        Entity player = (Entity)listPlayers.get(0);
+        double dx = Math.max(Math.abs(this.getX() - player.getX()) - 16.0, 0.0);
+        double dz = Math.max(Math.abs(this.getZ() - player.getZ()) - 16.0, 0.0);
+        double distSq = dx * dx + dz * dz;
+        return !this.shouldRenderAtSqrDistance(distSq);
+    }
