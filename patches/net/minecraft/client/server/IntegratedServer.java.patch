+   @Override
+   public boolean saveAllChunks(boolean silentIn, boolean flushIn, boolean commandIn) {
+      if (silentIn) {
+         int ticks = this.getTickCount();
+         int ticksSaveInterval = this.minecraft.options.ofAutoSaveTicks;
+         if (ticks < this.ticksSaveLast + ticksSaveInterval) {
+            return false;
+         }
+
+         this.ticksSaveLast = ticks;
+      }
+
+      return super.saveAllChunks(silentIn, flushIn, commandIn);
+   }
