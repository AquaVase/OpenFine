+
+   public static Identifier getCustomTexture(Identifier locationIn) {
+      if (Minecraft.getInstance() == null) {
+         return locationIn;
+      }
+
+      if (Config.isRandomEntities()) {
+         locationIn = RandomEntities.getTextureLocation(locationIn);
+      }
+
+      if (EmissiveTextures.isActive()) {
+         locationIn = EmissiveTextures.getEmissiveTexture(locationIn);
+      }
+
+      return locationIn;
+   }
+
+   public static RenderType getCustomRenderType(RenderType renderType) {
+      Identifier textureLoc = renderType.getTextureLocation();
+      if (textureLoc == null) {
+         return renderType;
+      }
+
+      Identifier customTextureLoc = getCustomTexture(textureLoc);
+      return customTextureLoc == null ? renderType : renderType.getTextured(textureLoc);
+   }
+}
