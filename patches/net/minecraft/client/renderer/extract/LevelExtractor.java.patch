+
+   public void applyFrustumEntities(Frustum camera, int maxChunkDistance) {
+      this.levelRenderer.getRenderInfosEntities().clear();
+      int cameraChunkX = (int)camera.getCameraX() >> 4 << 4;
+      int cameraChunkY = (int)camera.getCameraY() >> 4 << 4;
+      int cameraChunkZ = (int)camera.getCameraZ() >> 4 << 4;
+      int maxChunkDistSq = maxChunkDistance * maxChunkDistance;
+      EntitySectionStorage<?> entitySectionStorage = this.level.getSectionStorage();
+      BlockPosM posM = new BlockPosM();
+      LongSet posLongSet = entitySectionStorage.getSectionKeys();
+      LongIterator it = posLongSet.iterator();
+
+      while (it.hasNext()) {
+         long posLong = it.nextLong();
+         posM.setXyz(
+            SectionPos.sectionToBlockCoord(SectionPos.x(posLong)),
+            SectionPos.sectionToBlockCoord(SectionPos.y(posLong)),
+            SectionPos.sectionToBlockCoord(SectionPos.z(posLong))
+         );
+         SectionRenderDispatcher.RenderSection renderChunk = this.levelRenderer.viewArea().getRenderSectionAt(posM);
+         if (renderChunk != null && camera.isVisible(renderChunk.getBoundingBox())) {
+            if (maxChunkDistance > 0) {
+               BlockPos posChunk = renderChunk.getPosition();
+               int dx = cameraChunkX - posChunk.getX();
+               int dy = cameraChunkY - posChunk.getY();
+               int dz = cameraChunkZ - posChunk.getZ();
+               int chunkDistSq = dx * dx + dy * dy + dz * dz;
+               if (chunkDistSq > maxChunkDistSq) {
+                  continue;
+               }
+            }
+
+            this.levelRenderer.getRenderInfosEntities().add(posLong);
+         }
+      }
+   }
