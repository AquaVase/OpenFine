+
+    private boolean isRenderItem(Entity itemFrame) {
+        if (Shaders.isShadowPass) {
+            return false;
+        }
+
+        if (!Config.zoomMode) {
+            Entity viewEntity = mc.getCameraEntity();
+            double distSq = itemFrame.distanceToSqr(viewEntity.getX(), viewEntity.getY(), viewEntity.getZ());
+            if (distSq > itemRenderDistanceSq) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    public static void updateItemRenderDistance() {
+        Minecraft mc = Minecraft.getInstance();
+        double fov = Config.limit(mc.options.fov().get(), 1, 120);
+        double itemRenderDistance = Math.max(6.0 * mc.getWindow().getHeight() / fov, 16.0);
+        itemRenderDistanceSq = itemRenderDistance * itemRenderDistance;
+    }
+
+    public static boolean isRenderItemFrame() {
+        return renderItemFrame;
