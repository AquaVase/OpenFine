+    public <T extends RenderLayer> List<T> getLayers(Class<T> cls) {
+        List<RenderLayer> list = new ArrayList<>();
+
+        for (RenderLayer layer : this.layers) {
+            if (cls.isInstance(layer)) {
+                list.add(layer);
+            }
+        }
+
+        return (List<T>)list;
+    }
+
+    public void removeLayers(Class cls) {
+        Iterator it = this.layers.iterator();
+
+        while (it.hasNext()) {
+            RenderLayer layer = (RenderLayer)it.next();
+            if (cls.isInstance(layer)) {
+                it.remove();
+            }
+        }
+    }
+
+    public void replaceLayer(Class cls, RenderLayer layer) {
+        int index = this.getLayerIndex(cls);
+        this.removeLayers(cls);
+        if (index >= 0) {
+            this.layers.add(index, layer);
+        } else {
+            this.layers.add(layer);
+        }
+    }
+
+    public int getLayerIndex(Class cls) {
+        for (int i = 0; i < this.layers.size(); i++) {
+            RenderLayer layer = this.layers.get(i);
+            if (cls.isInstance(layer)) {
+                return i;
+            }
+        }
+
+        return -1;
+    }
