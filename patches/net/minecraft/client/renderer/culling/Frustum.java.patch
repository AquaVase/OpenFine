+            Vector4f vector4f = this.planes[i];
+            float x = vector4f.x();
+            float y = vector4f.y();
+            float z = vector4f.z();
+            float w = vector4f.w();
+            if (x * minX + y * minY + z * minZ + w <= 0.0F
