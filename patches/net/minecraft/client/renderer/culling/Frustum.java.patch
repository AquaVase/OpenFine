+                && x * minX + y * maxY + z * minZ + w <= 0.0F
+                && x * maxX + y * maxY + z * minZ + w <= 0.0F
+                && x * minX + y * minY + z * maxZ + w <= 0.0F
+                && x * maxX + y * minY + z * maxZ + w <= 0.0F
