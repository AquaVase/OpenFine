+   private static Pair<Identifier, CuboidModel> fixBlockModel(Identifier locationModelIn, CuboidModel modelIn) {
+      Identifier parent = resolveRelative(locationModelIn, modelIn.parent());
+      if (parent != modelIn.parent()) {
+         modelIn = new CuboidModel(modelIn.geometry(), modelIn.guiLight(), modelIn.ambientOcclusion(), modelIn.transforms(), modelIn.textureSlots(), parent);
+      }
+
+      return new Pair<>(locationModelIn, modelIn);
+   }
+
+   public static Identifier resolveRelative(Identifier locationModelIn, Identifier locationIn) {
+      if (locationModelIn != null && locationIn != null) {
+         if (locationIn.getPath().startsWith("./")) {
+            String basePath = PathUtils.removeLast(locationModelIn.getPath());
+            String pathFull = StrUtils.replacePrefix(locationIn.getPath(), "./", basePath + "/");
+            locationIn = locationIn.withPath(pathFull);
+         }
+
+         return locationIn;
+      } else {
+         return locationIn;
+      }
+   }
+
